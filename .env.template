# Copy to .env (gitignored) and fill in values

# WARNING: NEVER share your account credentials, commit them, or expose them in logs.

# =============================================================================
# Interactive Brokers
# =============================================================================
# Paper trading account ID
IBKR_PAPER_ACCOUNT=

# Live trading account ID (use with extreme caution)
# IBKR_LIVE_ACCOUNT=

# TWS/Gateway port (Paper: TWS 7497 / Gateway 4002, Live: TWS 7496 / Gateway 4001)
IBKR_PORT=7497

# Client ID for API connection (any unique integer, default: random)
# IBKR_CLIENT_ID=1

# Flex Web Service (HTTPS corporate-action reconciliation — independent of TWS/Gateway).
# Create a token under Account Management → Reports → Flex Queries → Flex Web Service Configuration,
# and a saved Activity query (with the Corporate Actions section) whose Query ID goes below.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# =============================================================================
# Hyperliquid
# =============================================================================
# WARNING: This is your wallet's PRIVATE KEY. It controls your ENTIRE account
# and ALL funds. NEVER share it, commit it, or expose it in logs.
# The same key works for both testnet and mainnet.
HYPERLIQUID_PRIVATE_KEY=

# Use testnet (true) or mainnet (false)
HYPERLIQUID_TESTNET=true

# =============================================================================
# Binance
# =============================================================================
# Get keys from:
#   Testnet: https://testnet.binance.vision/ (login with GitHub, click Generate HMAC_SHA256 Key)
#   Production: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Use testnet (true) or production (false)
BINANCE_TESTNET=true

# The two subaccount keys below are for the maintainers' own development and live testing; a
# library user most likely does not need them. Both are PRODUCTION keys, for live checks that
# have no testnet (Binance margin: user-data streams, listen keys, orders and borrowing).

# A read-only key on an otherwise empty subaccount. Give it "Enable Reading" only, never trading
# or withdrawal permission, and keep at most a token balance in the subaccount (cross margin and
# one isolated pair activated by a small transfer). The ignored live tests that only read use it.
BINANCE_SUBACCOUNT_READONLY_API_KEY=
BINANCE_SUBACCOUNT_READONLY_API_SECRET=

# A trading key on a second, dedicated subaccount that holds only what the real-money tests may
# spend (about 10 USDT in cross margin and 10 USDT in one isolated pair). Give it "Enable
# Reading", "Enable Spot & Margin Trading" and "Enable Margin Loan, Repay & Transfer" (the
# cleanup repays leftover interest), never withdrawal permission, and restrict it to your IP. The real-money tests use it only when explicitly opted in, place the smallest orders
# Binance accepts far from the market, cancel them, repay any borrowing, and refuse to start
# unless the subaccount is flat. Never point it at an account anything else trades.
BINANCE_SUBACCOUNT_TRADING_API_KEY=
BINANCE_SUBACCOUNT_TRADING_API_SECRET=

# =============================================================================
# Alpaca
# =============================================================================
# Get keys from: https://app.alpaca.markets → Paper Trading → API Keys
# Same keys work for both Trading API and Market Data API
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Use paper trading (true) or live trading (false)
ALPACA_PAPER=true

# =============================================================================
# Databento
# =============================================================================
# Get API key from: https://databento.com/portal/keys
# Provides institutional-grade market data for equities, futures, options
DATABENTO_API_KEY=

# =============================================================================
# Massive (formerly Polygon.io)
# =============================================================================
# Get API key from: https://massive.com/dashboard/api-keys
# Provides market data across stocks, options, indices, forex, crypto, futures
MASSIVE_API_KEY=

# =============================================================================
# London Strategic Edge (LSE)
# =============================================================================
# Get a free API key from:
#   https://londonstrategicedge.com/data
# Free, no-account market data covering FX/stocks/crypto/options/futures/CFDs/macro.
# See https://londonstrategicedge.com/terms for their Terms of Service
LSE_API_KEY=

# =============================================================================
# ThetaData
# =============================================================================
# Create an account at:
#   https://www.thetadata.net
# US options, stocks, indices, interest rates and the market calendar
# (rustrade-data `thetadata` feature), through a Theta Terminal you run
# (ThetaData's Java 21 app). The key is the Terminal's own login, read from its
# environment; the library and its tests read only THETADATA_BASE_URL.
# The Terminal's API has no authentication: keep its port off the network
# (a firewall, or a container that publishes it only to 127.0.0.1).
# The data is for personal, non-commercial use and must not be redistributed.
# See https://www.thetadata.net/terms-and-conditions for their Terms of Service
THETADATA_API_KEY=
# Optional; defaults to http://127.0.0.1:25503/v3
THETADATA_BASE_URL=

# =============================================================================
# SEC EDGAR
# =============================================================================
# No key. SEC's fair-access policy requires every automated request to declare
# who sends it: a User-Agent holding a name (yours or your application's) and a
# contact email. Quote the value: it contains spaces, and an unquoted value
# breaks when the file is sourced by a shell. SEC caps requests at 10 per second.
# See https://www.sec.gov/search-filings/edgar-search-assistance/accessing-edgar-data
# SEC_EDGAR_USER_AGENT="Sample Company Name admin@example.com"
SEC_EDGAR_USER_AGENT=

# =============================================================================
# Alpha Vantage
# =============================================================================
# Get a free API key from:
#   https://www.alphavantage.co/support/#api-key
# Earnings releases: the calendar of coming dates and past releases
# (rustrade-data `alpha-vantage` feature). The free tier allows 25 requests a day.
# The data is for personal, non-commercial use: use by a firm, or giving others
# access to it, needs a commercial licence.
# See https://www.alphavantage.co/terms_of_service/ for their Terms of Service
ALPHA_VANTAGE_API_KEY=
